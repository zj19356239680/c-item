APIGATE_SERVICE_NAME=api-gate
APIGATE_ENVIRONMENT=production
APIGATE_LOG_LEVEL=info
APIGATE_LISTEN_ADDRESS=127.0.0.1
APIGATE_LISTEN_PORT=8080
APIGATE_MAX_CONNECTIONS=256
APIGATE_MAX_CONCURRENT_PROXIES=32
# Optional single HTTP upstream; host and port enable it, and timeout may be omitted.
# APIGATE_UPSTREAM_HOST=upstream.internal
# APIGATE_UPSTREAM_PORT=8080
# APIGATE_UPSTREAM_TIMEOUT_MS=3000
