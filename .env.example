APIGATE_SERVICE_NAME=api-gate
APIGATE_ENVIRONMENT=production
APIGATE_LOG_LEVEL=info
APIGATE_LISTEN_ADDRESS=127.0.0.1
APIGATE_LISTEN_PORT=8080
# Optional single-listener HTTPS: provide BOTH a PEM certificate chain and matching unencrypted key.
# No client authentication/mTLS, second HTTP port, certificate generation or hot reload.
# APIGATE_TLS_CERT_FILE=/path/to/server-chain.pem
# APIGATE_TLS_KEY_FILE=/path/to/server-key.pem
APIGATE_MAX_CONNECTIONS=256
APIGATE_MAX_CONCURRENT_PROXIES=32
APIGATE_MAX_IN_FLIGHT_BYTES=67108864
APIGATE_SHUTDOWN_GRACE_MS=5000
# Strict true|false, default false. No authentication; reachable by all listener clients.
# Exposes GET /metrics on the existing listener; no additional port.
APIGATE_METRICS_ENABLED=false
# Strict true|false, default false. Cache at most 32 idle HTTP/HTTPS connections for 30 seconds.
# Stale reuse failures are returned without retries, including POST. Not a capacity guarantee.
APIGATE_UPSTREAM_KEEP_ALIVE=false
# Optional single HTTP upstream; host and port enable it, and timeout may be omitted.
# APIGATE_UPSTREAM_HOST=upstream.internal
# APIGATE_UPSTREAM_PORT=8080
# APIGATE_UPSTREAM_TIMEOUT_MS=3000
# Alternatively configure static path routes; unset ALL three legacy upstream variables first.
# strip_prefix is boolean, defaults to false; true strips the matched raw path prefix only.
# Query bytes are preserved; root prefix / is unchanged. No path normalization is performed.
# rate_limit is optional (unlimited if omitted); both integers must be in 1-1000000.
# requests_per_second refills tokens; burst is the initial/maximum balance, shared per route/process.
# Exhaustion returns 429 with an advisory integer Retry-After, distinct from capacity 503.
# Health endpoints are exempt; this is not an upload/connection limit or a production capacity guarantee.
# APIGATE_ROUTES='[{"prefix":"/users","host":"127.0.0.1","port":9001,"strip_prefix":true,"rate_limit":{"requests_per_second":10,"burst":20}},{"prefix":"/orders","host":"127.0.0.1","port":9002,"timeout_ms":2000}]'
# Or use 1-16 upstreams per route, exclusive with route-level scheme/host/port/timeout_ms.
# Each slot requires host/port; timeout_ms defaults to 3000. Duplicate addresses stay separate slots.
# Round robin is shared per route/process and per request, reset on restart; rate_limit stays per route.
# Each selected backend supplies Host and timeout; business failures do not retry or eject.
# No cross-process coordination, client fairness, HA/failover or production capacity guarantee.
# APIGATE_ROUTES='[{"prefix":"/api","strip_prefix":true,"upstreams":[{"host":"127.0.0.1","port":9001},{"host":"127.0.0.1","port":9002,"timeout_ms":2000}],"rate_limit":{"requests_per_second":10,"burst":20}}]'
# Both backend forms accept scheme: "http" (default) or "https"; port remains required.
# Legacy APIGATE_UPSTREAM_* host/port/timeout variables remain HTTP-only.
# HTTPS verifies the chain and configured DNS/IP identity, minimum TLS 1.2, HTTP/1.1 only.
# DNS hosts send SNI; IP hosts verify IP SAN without DNS SNI. Downstream remains HTTP.
# Optional PEM CA replaces system trust, shared by all HTTPS backends; no insecure bypass.
# Explicit CA files are validated even without HTTPS; --check-config loads trust without DNS/network.
# APIGATE_UPSTREAM_CA_FILE=/path/to/private-ca.pem
# APIGATE_ROUTES='[{"prefix":"/api","strip_prefix":true,"upstreams":[{"host":"backend.example.com","port":443,"scheme":"https"},{"host":"127.0.0.1","port":9001}]}]'
# Optional per-route health_check (omitted = disabled), also supported by single-backend routes.
# path is required: starts with /, no query/fragment/spaces/control characters or full URL.
# Integer defaults/ranges: interval_ms=5000 (100-60000), timeout_ms=1000 (50-60000, <= interval).
# unhealthy_threshold=3, healthy_threshold=2 (both 1-10). Initial state is available; restart resets it.
# GET final headers/status only: 2xx succeeds, no body checks, redirects or 1xx handling.
# HTTPS probes use the same verified trust/identity/SNI. No downstream credentials/body are copied.
# At most 4 probes process-wide, one per slot; one total deadline; no business quota/budget consumption.
# All unavailable returns 503 no_healthy_upstream; local /healthz and /readyz are unchanged.
# No retries, passive circuit breaking, failover, cross-process state or HA guarantee.
# APIGATE_ROUTES='[{"prefix":"/api","upstreams":[{"host":"127.0.0.1","port":9001},{"host":"127.0.0.1","port":9002}],"health_check":{"path":"/healthz","interval_ms":5000,"timeout_ms":1000,"unhealthy_threshold":3,"healthy_threshold":2}}]'
