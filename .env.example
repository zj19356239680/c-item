APIGATE_SERVICE_NAME=api-gate
APIGATE_ENVIRONMENT=production
APIGATE_LOG_LEVEL=info
APIGATE_LISTEN_ADDRESS=127.0.0.1
APIGATE_LISTEN_PORT=8080
APIGATE_MAX_CONNECTIONS=256
APIGATE_MAX_CONCURRENT_PROXIES=32
APIGATE_MAX_IN_FLIGHT_BYTES=67108864
APIGATE_SHUTDOWN_GRACE_MS=5000
# Optional single HTTP upstream; host and port enable it, and timeout may be omitted.
# APIGATE_UPSTREAM_HOST=upstream.internal
# APIGATE_UPSTREAM_PORT=8080
# APIGATE_UPSTREAM_TIMEOUT_MS=3000
# Alternatively configure static path routes; unset ALL three legacy upstream variables first.
# strip_prefix is boolean, defaults to false; true strips the matched raw path prefix only.
# Query bytes are preserved; root prefix / is unchanged. No path normalization is performed.
# rate_limit is optional (unlimited if omitted); both integers must be in 1-1000000.
# requests_per_second refills tokens; burst is the initial/maximum balance, shared per route/process.
# Exhaustion returns 429 with an advisory integer Retry-After, distinct from capacity 503.
# Health endpoints are exempt; this is not an upload/connection limit or a production capacity guarantee.
# APIGATE_ROUTES='[{"prefix":"/users","host":"127.0.0.1","port":9001,"strip_prefix":true,"rate_limit":{"requests_per_second":10,"burst":20}},{"prefix":"/orders","host":"127.0.0.1","port":9002,"timeout_ms":2000}]'
